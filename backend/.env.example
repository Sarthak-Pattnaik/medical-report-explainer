# Copy this file to .env and fill in real values.
# Never commit .env. It is git-ignored; this example file is not.

# --- Required ---

# Supabase Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Long random string used to sign login tokens.
# Must be the same on every machine that shares the database.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# LLM providers (Groq is the main one, Gemini is the fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase Storage, where uploaded report files are kept
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Comma-separated frontend URLs allowed to call the API
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://medical-report-explainer-lake.vercel.app